{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractResult",
  "type": "object",
  "required": ["schema_version", "contract", "passed", "checks", "warnings", "errors"],
  "properties": {
    "schema_version": { "type": "string" },
    "contract": { "type": "string" },
    "passed": { "type": "boolean" },
    "path": { "type": ["string", "null"] },
    "artifact_type": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "message", "details", "remediation"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "message": { "type": "string" },
          "details": { "type": "object" },
          "remediation": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
