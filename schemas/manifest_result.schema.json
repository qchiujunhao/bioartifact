{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManifestResult",
  "type": "object",
  "required": [
    "schema_version",
    "manifest",
    "base_dir",
    "passed",
    "summary",
    "outputs",
    "errors"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "manifest": { "type": "string" },
    "base_dir": { "type": "string" },
    "passed": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": ["expected", "passed", "failed", "missing"],
      "properties": {
        "expected": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "missing": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "expected_type",
          "passed",
          "inspection",
          "type_check",
          "contract",
          "requirements",
          "errors"
        ],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "expected_type": { "type": ["string", "null"] },
          "passed": { "type": "boolean" },
          "inspection": { "type": ["object", "null"] },
          "type_check": {
            "type": "object",
            "required": ["passed", "message"],
            "properties": {
              "passed": { "type": "boolean" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          },
          "contract": { "type": ["object", "null"] },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "path",
                "expected_type",
                "passed",
                "exists",
                "inspection",
                "type_check",
                "contract",
                "errors"
              ],
              "properties": {
                "name": { "type": "string" },
                "path": { "type": ["string", "null"] },
                "expected_type": { "type": ["string", "null"] },
                "passed": { "type": "boolean" },
                "exists": { "type": "boolean" },
                "inspection": { "type": ["object", "null"] },
                "type_check": {
                  "type": ["object", "null"],
                  "required": ["passed", "message"],
                  "properties": {
                    "passed": { "type": "boolean" },
                    "message": { "type": "string" }
                  },
                  "additionalProperties": false
                },
                "contract": { "type": ["object", "null"] },
                "errors": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
